{
  "manifest_version": 3,
  "name": "Send to Jules — AI Coding Assistant Launcher",
  "short_name": "Send to Jules",
  "description": "Send code and tasks directly from your browser to Google Jules. Easily manage active coding sessions and repositories.",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://jules.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Jules",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "send-selection-to-jules": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Send selected text to Jules"
    }
  }
}
