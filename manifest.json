{
  "manifest_version": 3,
  "name": "Send to Jules",
  "version": "1.0.0",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://jules.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Poslať do Jules"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
